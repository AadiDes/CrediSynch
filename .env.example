# Copy to .env and fill in. NEVER commit .env
POSTGRES_PASSWORD=devpassword
KEYCLOAK_ADMIN_PASSWORD=admin
# AI layer (Phase 4): bedrock (default) or gemini - see README's "LLM provider" section.
# Bedrock needs no key here: `aws login` locally, an instance role on EC2. Gemini needs a key.
LLM_PROVIDER=bedrock
AWS_REGION=ap-south-1
GEMINI_API_KEY=
